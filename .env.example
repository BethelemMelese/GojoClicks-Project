# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: only needed if the dataset is private
SANITY_API_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pay-first booking accounts (shown before the booking form)
NEXT_PUBLIC_PAYMENT_ACCOUNT_NAME=GojoClicks Media
NEXT_PUBLIC_PAYMENT_TELEBIRR_NUMBER=
NEXT_PUBLIC_PAYMENT_CBE_BIRR_NUMBER=
NEXT_PUBLIC_PAYMENT_NOTE_HINT=Use your full name or phone number as the transfer note.

# Admin bookings panel (/admin)
ADMIN_PASSWORD=
# Required in production: random secret used to sign session tokens (not the password).
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Resend — booking notification emails
# Get an API key at https://resend.com
RESEND_API_KEY=
# Where new-booking alerts go (defaults to melesebety2673@gmail.com in code)
BOOKING_NOTIFY_TO=melesebety2673@gmail.com
# Use onboarding@resend.dev for testing, or your verified domain later
EMAIL_FROM="GojoClicks <onboarding@resend.dev>"
# Absolute site URL for admin links in emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
